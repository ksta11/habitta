# Backend API Configuration
# Replace with your local IP address (check with ipconfig on Windows or ifconfig on Mac/Linux)
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LOCAL_IP:3000

# Environment
NODE_ENV=development

# Instructions:
# 1. Copy this file to .env
# 2. Replace YOUR_LOCAL_IP with your actual local IP address
# 3. Make sure your backend is running on port 3000
# 4. Ensure both devices are on the same WiFi network
